# Non-secret systemd EnvironmentFile. Render placeholders before installing.
# Install as ~/.config/vps-ops/runtime.env; never add BWS_ACCESS_TOKEN here.
BWS_PROJECT_ID=<local-project-uuid>
PATH=/home/<admin-user>/.local/bin:/home/<admin-user>/.opencode/bin:/home/<admin-user>/.local/share/pnpm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
HERMES_DASHBOARD_PUBLIC_URL=https://<hermes-service-dns-name>
# For a non-default Bitwarden region, configure bws and optionally BWS_PROFILE.
