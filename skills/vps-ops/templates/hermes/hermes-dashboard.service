[Unit]
Description=Hermes Agent Dashboard
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
EnvironmentFile=%h/.config/vps-ops/runtime.env
LoadCredential=bws-token:%h/.config/vps-ops/bws-token
ExecStart=%h/.local/bin/vps-bwenv-exec.py hermes %h/.local/bin/hermes dashboard --host 127.0.0.1 --port 9119 --no-open
Environment=HERMES_HOME=%h/.hermes
Restart=on-failure
RestartSec=15
KillMode=control-group
TimeoutStopSec=60

[Install]
WantedBy=default.target
